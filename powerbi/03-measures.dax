// 3. Measures
//
// First create the measures table: Home > Enter data, name the table _Measures, keep the
// one empty column, Load. Then for each measure below: select _Measures, Home > New measure,
// paste the measure (from its name to the end of its expression), press Enter, and set
// the format string and display folder in the Measure tools ribbon and the Properties pane.
// When all measures exist, hide the empty column; _Measures moves to the top of the field list.
//
// Each measure's comment says what it returns, its format string and its display folder.
// Visuals use these measures only: no implicit sums dragged from columns. 25 measures.
//
// Every measure reads the star (Listing Price, Our Unit, Price Change and their dimensions), so
// the Site slicer reaches every number. The gold views answer the same questions pooled over all
// sites; with no slicer selected the measures equal them (checks in 06-checks.md):
// MEDIAN equals the views' percentile_cont(0.5), PERCENTILE.INC equals percentile_cont, and the
// views round to 2 decimals where the measures do not.
//
// "The latest run week" is the newest week_key in the whole fact, as in the views'
// (SELECT max(week_key) FROM gold.fact_listing_price): REMOVEFILTERS () makes it the same week
// on every site and in every area, so a site missing from the latest run shows blank, not an
// older week.


// ---------- Page 1: Market position (display folder: Market position) ----------

// Competitor listings in the latest run week, one row per site and listing, for whatever site,
// area, compound or unit type is in the filter. Counts rows, never distinct listing ids: the same
// id can belong to listings on two sites. Format: #,0  Folder: Market position
Listings =
VAR _LatestWeek = CALCULATE ( MAX ( 'Listing Price'[week_key] ), REMOVEFILTERS () )
RETURN
    CALCULATE ( COUNTROWS ( 'Listing Price' ), Week[week_key] = _LatestWeek )

// Median competitor asking price per m² in the latest run week. Format: #,0  Folder: Market position
Median Price Per m² =
VAR _LatestWeek = CALCULATE ( MAX ( 'Listing Price'[week_key] ), REMOVEFILTERS () )
RETURN
    CALCULATE ( MEDIAN ( 'Listing Price'[price_per_m2] ), Week[week_key] = _LatestWeek )

// The price per m² a quarter of the latest week's listings sit under. Format: #,0  Folder: Market position
P25 Price Per m² =
VAR _LatestWeek = CALCULATE ( MAX ( 'Listing Price'[week_key] ), REMOVEFILTERS () )
RETURN
    CALCULATE ( PERCENTILE.INC ( 'Listing Price'[price_per_m2], 0.25 ), Week[week_key] = _LatestWeek )

// The price per m² three quarters of the latest week's listings sit under. Format: #,0  Folder: Market position
P75 Price Per m² =
VAR _LatestWeek = CALCULATE ( MAX ( 'Listing Price'[week_key] ), REMOVEFILTERS () )
RETURN
    CALCULATE ( PERCENTILE.INC ( 'Listing Price'[price_per_m2], 0.75 ), Week[week_key] = _LatestWeek )

// Our units for sale. The Site slicer does not change it: our units are not on a site.
// Format: #,0  Folder: Market position
Our Units =
COUNTROWS ( 'Our Unit' )

// Median price per m² of our units in the filter; for one unit, its own price per m².
// Format: #,0  Folder: Market position
Our Price Per m² =
MEDIAN ( 'Our Unit'[price_per_m2] )

// For one unit of ours: the latest week's median price per m² of the listings of its type in its
// area, over the sites in the filter (any compound). Blank for several units, or when the sites in
// the filter have no listing of that type there. The base of every gap measure below.
// Format: #,0  Folder: Market position
Market Median Per m² =
VAR _LatestWeek = CALCULATE ( MAX ( 'Listing Price'[week_key] ), REMOVEFILTERS () )
VAR _Area = SELECTEDVALUE ( 'Our Unit'[area_key] )
VAR _Type = SELECTEDVALUE ( 'Our Unit'[type_key] )
RETURN
    IF (
        HASONEVALUE ( 'Our Unit'[unit_code] ),
        CALCULATE (
            MEDIAN ( 'Listing Price'[price_per_m2] ),
            REMOVEFILTERS ( Area ),
            REMOVEFILTERS ( 'Property Type' ),
            REMOVEFILTERS ( Compound ),
            Area[area_key] = _Area,
            'Property Type'[type_key] = _Type,
            Week[week_key] = _LatestWeek
        )
    )

// Our units with a market median to compare with; a unit whose type has no listing in its area on
// the sites in the filter drops out. Format: #,0  Folder: Market position
Units Compared =
VAR _Units = ADDCOLUMNS ( 'Our Unit', "@Market", [Market Median Per m²] )
RETURN
    COUNTROWS ( FILTER ( _Units, NOT ISBLANK ( [@Market] ) ) )

// Share of compared units priced per m² above their market median. Format: 0.0%  Folder: Market position
Share Above Market =
VAR _Units = ADDCOLUMNS ( 'Our Unit', "@Market", [Market Median Per m²] )
VAR _Compared = FILTER ( _Units, NOT ISBLANK ( [@Market] ) )
VAR _Above = FILTER ( _Compared, 'Our Unit'[price_per_m2] > [@Market] )
RETURN
    DIVIDE ( COUNTROWS ( _Above ), COUNTROWS ( _Compared ) )

// Share of compared units priced per m² at or below their market median; with Share Above Market
// it makes 100%. Format: 0.0%  Folder: Market position
Share Below Market =
VAR _Units = ADDCOLUMNS ( 'Our Unit', "@Market", [Market Median Per m²] )
VAR _Compared = FILTER ( _Units, NOT ISBLANK ( [@Market] ) )
VAR _Below = FILTER ( _Compared, 'Our Unit'[price_per_m2] <= [@Market] )
RETURN
    DIVIDE ( COUNTROWS ( _Below ), COUNTROWS ( _Compared ) )

// Median gap of our price per m² against the market median, over the compared units; above zero
// means we ask more. For one unit, its own gap. Format: 0.0%  Folder: Market position
Median Gap =
VAR _Units = ADDCOLUMNS ( 'Our Unit', "@Market", [Market Median Per m²] )
VAR _Compared = FILTER ( _Units, NOT ISBLANK ( [@Market] ) )
RETURN
    MEDIANX ( _Compared, DIVIDE ( 'Our Unit'[price_per_m2] - [@Market], [@Market] ) )

// The area whose median gap is furthest from zero, above or below; on a tie, the name last in
// alphabetical order. With no slicer it is gap_rank 1 in gold.area_gap. Format: none (text)
// Folder: Market position
Widest Gap Area =
VAR _Areas = FILTER ( VALUES ( Area[name] ), NOT ISBLANK ( [Median Gap] ) )
VAR _Widest = TOPN ( 1, _Areas, ABS ( [Median Gap] ), DESC )
RETURN
    MAXX ( _Widest, Area[name] )

// The latest week's listings in the areas and unit types where we have units in the filter (the
// sites in the filter, any compound), each listing counted once. For one unit of ours, the listings
// of its type in its area. Format: #,0  Folder: Market position
Listings Compared =
SUMX (
    SUMMARIZE ( 'Our Unit', 'Our Unit'[area_key], 'Our Unit'[type_key] ),
    VAR _Area = 'Our Unit'[area_key]
    VAR _Type = 'Our Unit'[type_key]
    RETURN
        CALCULATE (
            [Listings],
            REMOVEFILTERS ( Area ),
            REMOVEFILTERS ( 'Property Type' ),
            REMOVEFILTERS ( Compound ),
            Area[area_key] = _Area,
            'Property Type'[type_key] = _Type
        )
)

// Of those listings, the ones asking less per m² than our median unit of their type and area (the
// units in the filter). For one unit of ours, the median is its own price per m².
// Format: #,0  Folder: Market position
Listings Cheaper Than Ours =
SUMX (
    SUMMARIZE ( 'Our Unit', 'Our Unit'[area_key], 'Our Unit'[type_key] ),
    VAR _Area = 'Our Unit'[area_key]
    VAR _Type = 'Our Unit'[type_key]
    VAR _Ours = CALCULATE ( MEDIAN ( 'Our Unit'[price_per_m2] ) )
    RETURN
        CALCULATE (
            [Listings],
            REMOVEFILTERS ( Area ),
            REMOVEFILTERS ( 'Property Type' ),
            REMOVEFILTERS ( Compound ),
            Area[area_key] = _Area,
            'Property Type'[type_key] = _Type,
            'Listing Price'[price_per_m2] < _Ours
        )
)

// Share of the compared listings that ask less per m² than our median unit of their type and area;
// with no slicer it equals share_listings_cheaper_than_ours in analysis/numbers.json (check C3), and
// for one unit of ours its pct_listings_cheaper in gold.unit_gap. It is not gold.area_gap's
// pct_listings_cheaper, which compares every unit with every listing. Format: 0.0%  Folder: Market position
Share Of Listings Cheaper Than Ours =
DIVIDE ( [Listings Cheaper Than Ours], [Listings Compared] )


// ---------- Page 2: Compounds and developers (display folder: Compounds) ----------

// Compounds with at least one listing in the latest run week, counted by name; Unknown (the site
// named none) is not counted. Format: #,0  Folder: Compounds
Compounds Covered =
VAR _LatestWeek = CALCULATE ( MAX ( 'Listing Price'[week_key] ), REMOVEFILTERS () )
VAR _Named =
    CALCULATETABLE (
        SUMMARIZE ( 'Listing Price', Compound[compound] ),
        Week[week_key] = _LatestWeek,
        Compound[compound] <> "Unknown"
    )
RETURN
    COUNTROWS ( _Named )

// Developers with at least one listing in the latest run week, counted by name; Unknown is not
// counted. Format: #,0  Folder: Compounds
Developers Covered =
VAR _LatestWeek = CALCULATE ( MAX ( 'Listing Price'[week_key] ), REMOVEFILTERS () )
VAR _Named =
    CALCULATETABLE (
        SUMMARIZE ( 'Listing Price', Compound[developer] ),
        Week[week_key] = _LatestWeek,
        Compound[developer] <> "Unknown"
    )
RETURN
    COUNTROWS ( _Named )

// The compound with the lowest median price per m² in the latest run week; Unknown is left out;
// on a tie, the name last in alphabetical order. Format: none (text)  Folder: Compounds
Cheapest Compound =
VAR _Compounds =
    FILTER (
        VALUES ( Compound[compound] ),
        Compound[compound] <> "Unknown" && NOT ISBLANK ( [Median Price Per m²] )
    )
VAR _Cheapest = TOPN ( 1, _Compounds, [Median Price Per m²], ASC )
RETURN
    MAXX ( _Cheapest, Compound[compound] )

// The compound with the highest median price per m² in the latest run week; same rules as
// Cheapest Compound. Format: none (text)  Folder: Compounds
Dearest Compound =
VAR _Compounds =
    FILTER (
        VALUES ( Compound[compound] ),
        Compound[compound] <> "Unknown" && NOT ISBLANK ( [Median Price Per m²] )
    )
VAR _Dearest = TOPN ( 1, _Compounds, [Median Price Per m²], DESC )
RETURN
    MAXX ( _Dearest, Compound[compound] )


// ---------- Page 3: Weekly changes (display folder: Weekly changes) ----------

// Every change of price per m²; blank until the second weekly run. Format: #,0  Folder: Weekly changes
Price Changes =
COUNTROWS ( 'Price Change' )

// Changes that lowered the price per m². Format: #,0  Folder: Weekly changes
Price Cuts =
CALCULATE ( [Price Changes], 'Price Change'[Direction] = "Cut" )

// Changes that raised the price per m². Format: #,0  Folder: Weekly changes
Price Rises =
CALCULATE ( [Price Changes], 'Price Change'[Direction] = "Rise" )

// Average size of a change, in percent of the old price per m². change_pct is stored in percent
// (-4.5), so it is divided by 100 for the % format. Format: 0.0%  Folder: Weekly changes
Average Change =
VAR _ChangeInPercent = AVERAGE ( 'Price Change'[change_pct] )
RETURN
    DIVIDE ( _ChangeInPercent, 100 )

// One listing's asking price per m² in a run week, shown only when one listing id on one site is
// in the filter: averaging different listings would mean nothing. One price per site, listing and
// week, so the average is that price. Format: #,0  Folder: Weekly changes
Competitor Price Per m² =
VAR _OneListing =
    HASONEVALUE ( 'Listing Price'[listing_id] ) && HASONEVALUE ( 'Listing Price'[site_key] )
RETURN
    IF ( _OneListing, AVERAGE ( 'Listing Price'[price_per_m2] ) )

// Median price per m² of our units of the same type in the same area as the one listing picked;
// blank when several listings are in the filter or we have no unit of that type there. The
// listing's area and type decide, so the Area, Type and Compound filters are removed.
// Format: #,0  Folder: Weekly changes
Our Same-Type Price Per m² =
VAR _OneListing =
    HASONEVALUE ( 'Listing Price'[listing_id] ) && HASONEVALUE ( 'Listing Price'[site_key] )
VAR _Area = SELECTEDVALUE ( 'Listing Price'[area_key] )
VAR _Type = SELECTEDVALUE ( 'Listing Price'[type_key] )
RETURN
    IF (
        _OneListing,
        CALCULATE (
            MEDIAN ( 'Our Unit'[price_per_m2] ),
            REMOVEFILTERS ( Area ),
            REMOVEFILTERS ( 'Property Type' ),
            REMOVEFILTERS ( Compound ),
            'Our Unit'[area_key] = _Area,
            'Our Unit'[type_key] = _Type
        )
    )
